    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ethers": "^6.16.0",
    "i18next": "^23.16.0",
    "lucide-react": "^0.576.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.13.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.5.0",
